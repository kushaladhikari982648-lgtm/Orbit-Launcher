<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/settings_layout"
        android:layout_width="144dp"
        android:layout_height="match_parent"
        android:background="@drawable/mc_panel"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            style="@style/MinecraftLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:text="@string/mc_settings"
            android:textSize="13sp" />

        <TextView
            style="@style/MinecraftLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:paddingHorizontal="4dp"
            android:text="@string/mc_auto_saved"
            android:textSize="9sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="6dp"
            android:background="@color/launcher_outline" />

        <HorizontalScrollView
            android:id="@+id/settings_tab_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/settings_tab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/tab_video"
                    style="@style/ModernNav"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/setting_category_video"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/tab_control"
                    style="@style/ModernNav"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/setting_category_control"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/tab_game"
                    style="@style/ModernNav"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/setting_category_game"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/tab_launcher"
                    style="@style/ModernNav"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/setting_category_launcher"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/tab_experimental"
                    style="@style/ModernNav"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:text="@string/setting_category_experimental"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/settings_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="4dp"
            android:text="@string/mc_auto_saved"
            android:textColor="@color/menu_bar_text"
            android:textSize="9sp" />
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/settings_viewpager"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/background_card"
        android:padding="4dp" />

</LinearLayout>
